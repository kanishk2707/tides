# Copy to .env and fill in. Never commit .env.

# Public hostname Caddy will obtain a certificate for. Must resolve to this machine.
DOMAIN=play.example.com

# Your Supabase project. The URL is https://<ref>.supabase.co from the dashboard.
SUPABASE_URL=https://kldficmkpzgkhfwcforh.supabase.co

# The SERVICE-ROLE secret (sb_secret_...). This is the one key that must never reach a client.
# Rotate it from Settings > API if it has ever been pasted anywhere.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Capacity. One box comfortably runs a few hundred concurrent players.
MAX_PLAYERS=400
MAX_PER_IP=6

# Seconds a quick-play queue waits before a bot is assigned.
BOT_FALLBACK_SECONDS=12

# Guests (no token) are refused whenever SUPABASE_URL is set. Only ever "true" on a dev box.
ALLOW_GUESTS=false
